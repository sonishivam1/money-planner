# Database. For local development, embedded Postgres needs no setup:
DATABASE_URL=pglite:./.data/dev
# Production: a Postgres connection string (Neon, Supabase or your own), e.g.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Auth.js: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=dev-only-change-me

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Emails allowed to sign in (comma-separated). In production an empty list blocks everyone.
ALLOWED_EMAILS=

# Local development only: show "Continue as dev user" on the login page (never works in production builds).
AUTH_DEV_LOGIN=1
DEV_LOGIN_EMAIL=dev@example.com
