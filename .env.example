# Postgres connection string (Neon, Supabase or local Postgres)
DATABASE_URL=postgres://user:password@localhost:5432/money_planner

# Auth.js: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email allowed to sign in (comma-separated). Leave empty to allow any Google account.
ALLOWED_EMAILS=
